{
  "name": "react",
  "version": "1.0.0",
  "description": "React example starter project",
  "keywords": [
    "react",
    "starter"
  ],
  "main": "src/index.tsx",
  "scripts": {
    "start": "cross-env GENERATE_SOURCEMAP=true SKIP_PREFLIGHT_CHECK=true DISABLE_ESLINT_PLUGIN=true node scripts/run-react-app.js start",
    "build": "cross-env SKIP_PREFLIGHT_CHECK=true DISABLE_ESLINT_PLUGIN=true node scripts/run-react-app.js build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cross-env SKIP_PREFLIGHT_CHECK=true node scripts/run-react-app.js test --env=jsdom",
    "eject": "react-scripts eject"
  },
  "browserslist": [
    "Chrome >= 78"
  ],
  "dependencies": {
    "prop-types": "15.8.1",
    "react-view-router": "link:..",
    "react-view-router-react-demo-shared": "file:../demo_react_shared",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-scripts": "4.0.3"
  },
  "devDependencies": {
    "@babel/runtime": "7.17.9",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "babel-preset-react-scope-style": "0.1.0-alpha.5",
    "cross-env": "7.0.3",
    "react-app-rewired": "2.2.1",
    "react-hooks": "^1.0.1",
    "sass": "1.62.1",
    "typescript": "6.0.3"
  }
}
