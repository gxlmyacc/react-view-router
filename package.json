{
  "name": "react-view-router",
  "version": "2.3.0",
  "description": "react-view-router",
  "keywords": [
    "react-view-router",
    "react",
    "router",
    "config-router"
  ],
  "sideEffects": false,
  "main": "esm/index.js",
  "module": "esm/index.js",
  "typings": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js",
      "require": "./esm/index.js",
      "default": "./esm/index.js"
    },
    "./dom": {
      "types": "./dom/types/index.d.ts",
      "import": "./dom/esm/index.js",
      "require": "./dom/esm/index.js",
      "default": "./dom/esm/index.js"
    },
    "./drawer": {
      "types": "./drawer/types/index.d.ts",
      "import": "./drawer/esm/index.js",
      "require": "./drawer/esm/index.js",
      "default": "./drawer/esm/index.js"
    },
    "./transition": {
      "types": "./transition/types/index.d.ts",
      "import": "./transition/esm/index.js",
      "require": "./transition/esm/index.js",
      "default": "./transition/esm/index.js"
    },
    "./standalone-modern": {
      "types": "./types/standalone-modern.d.ts",
      "import": "./esm/standalone-modern.js",
      "require": "./esm/standalone-modern.js",
      "default": "./esm/standalone-modern.js"
    },
    "./standalone-legacy": {
      "types": "./types/standalone-legacy.d.ts",
      "import": "./esm/standalone-legacy.js",
      "require": "./esm/standalone-legacy.js",
      "default": "./esm/standalone-legacy.js"
    },
    "./package.json": "./package.json",
    "./es": {
      "types": "./types/index.d.ts",
      "import": "./es/index.js",
      "require": "./es/index.js",
      "default": "./es/index.js"
    },
    "./es/dom": {
      "types": "./dom/types/index.d.ts",
      "import": "./dom/es/index.js",
      "require": "./dom/es/index.js",
      "default": "./dom/es/index.js"
    },
    "./es/drawer": {
      "types": "./drawer/types/index.d.ts",
      "import": "./drawer/es/index.js",
      "require": "./drawer/es/index.js",
      "default": "./drawer/es/index.js"
    },
    "./es/transition": {
      "types": "./transition/types/index.d.ts",
      "import": "./transition/es/index.js",
      "require": "./transition/es/index.js",
      "default": "./transition/es/index.js"
    },
    "./es/standalone-modern": {
      "types": "./types/standalone-modern.d.ts",
      "import": "./es/standalone-modern.js",
      "require": "./es/standalone-modern.js",
      "default": "./es/standalone-modern.js"
    },
    "./es/standalone-legacy": {
      "types": "./types/standalone-legacy.d.ts",
      "import": "./es/standalone-legacy.js",
      "require": "./es/standalone-legacy.js",
      "default": "./es/standalone-legacy.js"
    }
  },
  "engines": {
    "node": ">= 12"
  },
  "files": [
    "dist",
    "docs",
    "images",
    "README.md",
    "README_CN.md",
    "esm",
    "es",
    "src",
    "types",
    "drawer",
    "dom",
    "transition",
    "standalone-modern",
    "standalone-legacy"
  ],
  "scripts": {
    "build-transition": "npm run build-transition:js && npm run build-transition:es && node scripts/normalize-transition-style-import.js && node scripts/normalize-es-core-imports.js transition",
    "build-transition:js": "cross-env BUILD_ENV=js babel transition/src -d transition/esm --extensions \".ts,.tsx\" && sass --no-source-map transition/src/RouterView.scss transition/esm/router-view.css",
    "build-transition:es": "cross-env BUILD_ENV=es babel transition/src -d transition/es --extensions \".ts,.tsx\" && sass --no-source-map transition/src/RouterView.scss transition/es/router-view.css",
    "build-drawer": "npm run build-drawer:types && npm run build-drawer:js && npm run build-drawer:es && sass --no-source-map drawer/src/index.scss drawer/es/index.css && sass --no-source-map drawer/src/index.scss drawer/esm/index.css && node scripts/normalize-drawer-style-import.js && node scripts/normalize-es-core-imports.js drawer",
    "build-drawer:types": "tsc -p drawer --emitDeclarationOnly",
    "build-drawer:js": "cross-env BUILD_ENV=js babel drawer/src -d drawer/esm --extensions \".ts,.tsx\" --source-maps",
    "build-drawer:es": "cross-env BUILD_ENV=es babel drawer/src -d drawer/es --extensions \".ts,.tsx\"",
    "build-dom": "npm run build-dom:types && npm run build-dom:js && npm run build-dom:es && node scripts/normalize-es-core-imports.js dom",
    "build-dom:types": "tsc -p dom --emitDeclarationOnly",
    "build-dom:js": "cross-env BUILD_ENV=js babel dom/src -d dom/esm --extensions \".ts,.tsx\" --source-maps",
    "build-dom:es": "cross-env BUILD_ENV=es babel dom/src -d dom/es --extensions \".ts,.tsx\"",
    "build-src": "npm run build:types && npm run build:js && npm run build:es",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "cross-env BUILD_ENV=js babel src -d esm --extensions \".ts,.tsx\" --source-maps",
    "build:es": "cross-env BUILD_ENV=es babel src -d es --extensions \".ts,.tsx\"",
    "build": "npm run build-src && npm run build-drawer && npm run build-dom && npm run build-transition",
    "build-demo-site": "npm run build && npm --prefix demo_react16 run build && npm run verify-demo-site",
    "verify-demo-site": "node scripts/verify-demo-site.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxlmyacc/react-view-router.git"
  },
  "homepage": "https://github.com/gxlmyacc/react-view-router#readme",
  "bugs": {
    "url": "https://github.com/gxlmyacc/react-view-router/issues"
  },
  "author": "guoxl",
  "resolutions": {
    "eslint-plugin-import": "2.31.0"
  },
  "dependencies": {
    "core-js": "^3.50.0",
    "dom-helpers": "^5.2.1",
    "path-to-regexp": "^6.3.0",
    "react-transition-group": "^4.4.5",
    "tslib": "^2.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@playwright/test": "1.63.0-alpha-2026-08-05",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/browser-or-node": "^1.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^16.14.2",
    "@types/react-dom": "^16.9.16",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.4.1",
    "babel-plugin-define-variables": "^0.0.3",
    "babel-preset-react-scope-style": "0.1.0-alpha.5",
    "build-react-esm-project": "^0.1.3",
    "caniuse-lite": "^1.0.30001723",
    "cross-env": "^7.0.3",
    "eslint": "8.35.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.50.1",
    "typescript": "6.0.3",
    "acorn": "^8.8.0"
  }
}
