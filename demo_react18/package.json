{
  "name": "react",
  "version": "1.0.0",
  "description": "React example starter project",
  "keywords": [
    "react",
    "starter"
  ],
  "main": "src/index.tsx",
  "scripts": {
    "start": "node ../scripts/prepare-playground-assets.js . && cross-env GENERATE_SOURCEMAP=true SKIP_PREFLIGHT_CHECK=true DISABLE_ESLINT_PLUGIN=true react-app-rewired start",
    "build": "node ../scripts/prepare-playground-assets.js . && cross-env SKIP_PREFLIGHT_CHECK=true DISABLE_ESLINT_PLUGIN=true react-app-rewired build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cross-env SKIP_PREFLIGHT_CHECK=true react-app-rewired test --env=jsdom",
    "eject": "react-scripts eject"
  },
  "browserslist": [
    "Chrome >= 78"
  ],
  "dependencies": {
    "prop-types": "15.8.1",
    "react-view-router": "link:..",
    "react-view-router-react-demo-shared": "file:../demo_react_shared",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@babel/core": "^7.17.9",
    "@babel/plugin-transform-react-jsx": "^7.17.3",
    "@babel/runtime": "7.17.9",
    "babel-preset-react-scope-style": "0.1.0-alpha.5",
    "cross-env": "7.0.3",
    "eslint": "^8.13.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.4.0",
    "react-app-rewired": "2.2.1",
    "react-hooks": "^1.0.1",
    "sass": "1.62.1",
    "typescript": "6.0.3"
  }
}
