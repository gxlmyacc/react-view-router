{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "paths": {
      "react-view-router": ["../types/index.d.ts"],
      "react-view-router/dom": ["../dom/types/index.d.ts"],
      "react-view-router/transition": ["../transition/types/index.d.ts"],
      "react-view-router/drawer": ["../drawer/types/index.d.ts"],
      "react-view-router-react-demo-shared": ["./src/index.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"],
    "lib": ["DOM", "ES2018"]
  },
  "include": ["index.d.ts", "src/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
